{
  "name": "openteams-editor",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/lib/index.js",
  "module": "./dist/lib/index.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/lib/index.d.ts",
      "import": "./dist/lib/index.js"
    },
    "./styles.css": "./dist/lib/openteams-editor.css"
  },
  "files": [
    "dist/lib"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:lib": "tsc -p tsconfig.lib.json && vite build --config vite.config.lib.ts",
    "typecheck": "tsc -b",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "release:patch": "npm run build:lib && npm version patch && git push && git push --tags && npm publish",
    "release:minor": "npm run build:lib && npm version patch && git push && git push --tags && npm publish",
    "release:major": "npm run build:lib && npm version major && git push && git push --tags && npm publish"
  },
  "peerDependencies": {
    "@xyflow/react": "^12.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.5"
  },
  "dependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@xyflow/react": "^12.6.0",
    "ajv": "^8.17.1",
    "js-yaml": "^4.1.1",
    "jszip": "^3.10.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/js-yaml": "^4.0.9",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^28.1.0",
    "tailwindcss": "^4.1.4",
    "typescript": "^5.8.0",
    "vite": "^6.3.3",
    "vitest": "^3.1.0"
  },
  "overrides": {
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1"
  }
}
